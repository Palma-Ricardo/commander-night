# /etc/caddy/Caddyfile
#
# The only publicly reachable process (design §2): caddy owns TLS and the
# public name; the bridge listens on loopback :8484. Caddy proxies WebSocket
# upgrades transparently, and the bridge's permessage-deflate is negotiated
# end-to-end with the browser (protocol §3) — no compression config needed
# here. Replace the host with your domain (its DNS A record must point at
# this VPS; caddy then provisions the certificate automatically).

night.example.com {
	# ACME via DNS-01: issuance never depends on inbound port 80. Needs a
	# caddy binary with the route53 plugin and AWS creds in caddy's
	# environment — see "TLS via DNS-01" in the README. Drop this tls
	# block to fall back to HTTP-01 on a plain caddy build.
	tls {
		dns route53
	}

	# The bridge owns two paths; everything else is the static client. The
	# browser derives the /ws URL from its own origin (client src/app.ts), so
	# there is no build-time host configuration anywhere.
	handle /ws* {
		reverse_proxy 127.0.0.1:8484
	}

	# /healthz is the bridge's, not the SPA's. Before the static split a
	# blanket reverse_proxy carried it; without this it would fall through to
	# try_files and answer 200 with index.html — a health check that passes
	# while the bridge is down.
	handle /healthz {
		reverse_proxy 127.0.0.1:8484
	}

	handle {
		root * /opt/commander-night/client
		# Vite emits content-hashed asset filenames, so /assets/* can cache
		# forever. index.html must NOT: without this, pushing a fix mid-night
		# leaves every browser on the previous bundle with no way to know.
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		header /index.html Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
