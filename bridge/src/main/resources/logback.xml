<configuration>
  <!-- Per-seat MDC keys (game, seat) per design §12 — empty until a pump sets them. -->
  <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <pattern>%d{HH:mm:ss.SSS} %-5level %logger{26} [%X{game:-}/%X{seat:-}] %msg%n</pattern>
    </encoder>
  </appender>
  <root level="INFO">
    <appender-ref ref="STDOUT"/>
  </root>
</configuration>
